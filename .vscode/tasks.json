{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swift: Build",
      "type": "shell",
      "command": "swift build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Swift: Run",
      "type": "shell",
      "command": "swift run",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Swift: Test",
      "type": "shell",
      "command": "swift test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$swiftc"]
    }
  ]
}
